							"const res = pm.response.json();\r",
							"\r",
							"//  Status code validation\r",
							"pm.test(\"Status 200\", () => pm.response.to.have.status(200));\r",
							"\r",
							"//  Check updatedAt exists and is a string\r",
							"pm.test(\"updatedAt exists and is valid string\", () => {\r",
							"    pm.expect(res).to.have.property(\"updatedAt\");\r",
							"    pm.expect(res.updatedAt).to.be.a(\"string\");\r",
							"});\r",
							"\r",
							"//  Reqres-safe checks for updated fields\r",
							"pm.test(\"Name updated\", () => {\r",
							"    if (res.name) pm.expect(res.name).to.eql(\"Kristijan Manovski\");\r",
							"});\r",
							"\r",
							"pm.test(\"Job updated\", () => {\r",
