			"name": "Create User",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const res = pm.response.json();\r",
							"\r",
							"pm.test(\"Status 201\", () => pm.response.to.have.status(201));\r",
							"pm.test(\"Name returned\", () => pm.expect(res.name).to.eql(\"Kristijan\"));\r",
							"pm.test(\"Job returned\", () => pm.expect(res.job).to.eql(\"QA Engineer\"));\r",
							"pm.test(\"createdAt exists\", () => pm.expect(res).to.have.property(\"createdAt\"));\r",
							"\r",
							"pm.test(\"ID exists\", () => pm.expect(res).to.have.property(\"id\"));\r",
							""
